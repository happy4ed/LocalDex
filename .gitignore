# Visual Studio user and build output
.vs/
**/[Bb]in/
**/[Oo]bj/
*.user
*.suo
*.userosscache
*.sln.docstates

# Local build helper downloaded for this machine
.build-tools/

# Runtime-only data
**/logs/
**/screenshots/
DexManager/screenshot/*
!DexManager/screenshot/.gitkeep
*.log
*.tmp

# NuGet restore output
packages/
*.nupkg

# Generated release packages
dist/
# macOS system files
.DS_Store
**/.DS_Store

# User local settings
**/config/settings.json
**/config/settings.json.*
**/*.dSYM/


# LocalDex write-ahead phone-setting recovery records
**/config/freeform-recovery/

# Downloaded and checksum-verified by scripts/Update-Scrcpy.ps1
DexManager/tools/scrcpy/*
!DexManager/tools/scrcpy/README.md
