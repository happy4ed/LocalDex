<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DexManager.AdbProxy</RootNamespace>
    <AssemblyName>LocalDexAdbProxy</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Title>LocalDex ADB Proxy</Title>
    <Description>ADB compatibility helper for LocalDex</Description>
    <Company>maze</Company>
    <Product>LocalDex</Product>
    <Copyright>Copyright © 2026 maze</Copyright>
    <Version>2.1.0-localdex.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\FileTransferProtocol.cs">
      <Link>Shared\FileTransferProtocol.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
